#!/bin/nu
def main [
    path: string,
    --model: string = "gemini-3.5-transcribe",
] {
    let api_key = ($env.GEMINI_API_KEY? | default "" | str trim)
    if ($api_key | is-empty) {
        print --stderr "GEMINI_API_KEY is not set. Create a separate Gemini API key at https://aistudio.google.com/api-keys and set GEMINI_API_KEY in your shell."
        print --stderr "This script uses the Gemini Interactions API; VERTEX_AI_API_KEY is not a fallback for this endpoint."
        exit 1
    }

    let mime_type = (^file --brief --mime-type $path | str trim)
    let audio = (open $path | into binary | encode base64)
    let prompt = """
Transcribe this audio faithfully.
Return only the transcript, with timestamps in [HH:MM:SS] format when possible.
Preserve speaker turns and label distinct speakers as Speaker A, Speaker B, etc.
Do not summarize or add commentary.
"""

    let url = "https://generativelanguage.googleapis.com/v1beta/interactions"
    let body = {
        model: $model
        input: [
            { type: "audio", data: $audio, mime_type: $mime_type }
            { type: "text", text: $prompt }
        ]
        store: false
    }

    let raw = (
        http post
            --content-type 'application/json'
            --headers { 'x-goog-api-key': $api_key }
            --full
            --allow-errors
            $url
            $body
    )

    if $raw.status >= 400 {
        print --stderr $"HTTP ($raw.status)"
        let error_body = ($raw.body | to json)
        print --stderr $error_body
        if ($error_body | str contains "API_KEY_SERVICE_BLOCKED") {
            print --stderr "GEMINI_API_KEY cannot access generativelanguage.googleapis.com. Use a separate Gemini API key from Google AI Studio, restricted to the Gemini API."
        }
        exit 1
    }

    let text = (
        $raw.body.steps
        | where type == "model_output"
        | each {|step| $step.content | where type == "text" | get text }
        | flatten
        | str join "\n"
    )

    {
        text: $text
        usage: $raw.body.usage
    } | select text usage
}
