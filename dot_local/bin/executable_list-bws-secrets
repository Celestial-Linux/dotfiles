#!/usr/bin/env nu

const usage = "Usage: list-bws-secrets

List the available Bitwarden Secrets Manager secrets as KEY = ID.
Secret values are never displayed.

Options:
  -h, --help  Show this help."

const access_token_env = "BWS_AUTH_TOKEN"

def --wrapped main [
    ...args: string
] {
    if (($args | length) > 0) and not ((($args | length) == 1) and (($args.0 == "--help") or ($args.0 == "-h"))) {
        print --stderr $usage
        exit 64
    }

    if (($args | length) == 1) {
        print $usage
        exit 0
    }

    if (which bws | is-empty) {
        print --stderr "list-bws-secrets: bws was not found in PATH"
        exit 127
    }

    let access_token = ($env | get --optional $access_token_env)
    if ($access_token == null) or ($access_token == "") {
        print --stderr $"list-bws-secrets: ($access_token_env) must be set for --access-token"
        exit 78
    }

    try {
        ^bws --access-token $access_token secret list --output json
        | from json
        | each { |secret| $"($secret.key) = ($secret.id)" }
        | str join (char newline)
        | print
    } catch { |err|
        print --stderr $"list-bws-secrets: failed to list secrets: ($err.msg)"
        let exit_code = ($env | get --optional LAST_EXIT_CODE)
        if ($exit_code == null) or ($exit_code == 0) {
            exit 1
        }
        exit $exit_code
    }
}
